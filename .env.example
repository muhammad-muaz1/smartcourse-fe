# Gateway the Vite dev server proxies /api, /health and /version to.
VITE_GATEWAY_URL=http://localhost:8000

# Base URL the browser calls. Empty = same origin (dev proxy / reverse proxy in prod).
VITE_API_BASE_URL=

# Observability consoles linked from the Demo page (deploy/docker-compose.yml ports).
VITE_JAEGER_URL=http://localhost:16686
VITE_GRAFANA_URL=http://localhost:3001
VITE_PROMETHEUS_URL=http://localhost:9090
VITE_TEMPORAL_UI_URL=http://localhost:8233
VITE_RABBITMQ_URL=http://localhost:15672
